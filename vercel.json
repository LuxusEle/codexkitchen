{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/cloud.js": {"maxDuration": 60},"api/auth.js":{"maxDuration":60}},
  "rewrites": [{"source":"/api/auth/:path*","destination":"/api/auth?path=:path*"}],
  "headers": [{"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]}]
}
