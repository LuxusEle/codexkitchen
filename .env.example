DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# Use a development branch's DIRECT connection for migrations, never the pooled endpoint.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-DEV-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.us-east-2.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://YOUR-ENDPOINT.neonauth.us-east-2.aws.neon.tech/neondb/auth
BLOB_READ_WRITE_TOKEN=
# Admin's underlying Neon account email; also accepted as an alternative login identifier.
ADMIN_EMAIL=owner@example.com
ADMIN_USER_ID=
APP_ORIGIN=https://codexkitchen.vercel.app
LOGIN_ALERT_TO=luxuselemente@gmail.com
SMTP_USER=
# Gmail App Password, not the ordinary Gmail/account password.
SMTP_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
